# LLM provider: ollama, gemini, or openrouter
LLM_PROVIDER=ollama

# YouTube Data API v3 key
YOUTUBE_API_KEY=AIzaSyCW_hIaYdoLDixo4LqHIR3Jze1pOsWn2ug

# Google Gemini API (alternative provider)
GEMINI_API_KEY="Your Gemini API KEY"
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API (alternative provider)
OPENROUTER_API_KEY="Your Open Router Key"
OPENROUTER_MODEL=openrouter/free

# Local Ollama (default provider)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5vl:7b

# Research pipeline (Tavily — get a free key at https://tavily.com)
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=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
RESEARCH_DIR=D:\Research Files

# TTS engine: piper (default, more natural) or kokoro
TTS_ENGINE=piper
# Piper voice (quality: high > medium > low). en_US-ryan-high is a
# high-quality US male voice; en_US-lessac-high is female.
PIPER_VOICE=en_US-ryan-high
# Kokoro TTS voice (used only when TTS_ENGINE=kokoro)
KOKORO_VOICE=us_puck